# Waveshare 2.8inch DPI LCD on Raspberry Pi OS Bookworm/Trixie.
# Append to /boot/firmware/config.txt on the SD-card boot partition.
# Copy vendor/waveshare-28dpi/overlays/*.dtbo to bootfs/overlays/ first.

# Keep KMS for the vendor Bookworm overlay path.
dtoverlay=vc4-kms-v3d

# Waveshare vendor overlays for 2.8inch DPI LCD and touch.
dtoverlay=waveshare-28dpi-3b-4b
dtoverlay=waveshare-28dpi-3b
dtoverlay=waveshare-28dpi-4b
dtoverlay=waveshare-touch-28dpi
dtoverlay=vc4-kms-dpi-2inch8

# Legacy Waveshare 2.8inch DPI LCD config.
# Use this if Bookworm/KMS shows early boot and then blanks after userspace.
# Append to /boot/firmware/config.txt or /boot/config.txt.
# IMPORTANT: comment out dtoverlay=vc4-kms-v3d and dtoverlay=vc4-fkms-v3d
# when using this legacy DPI block.

gpio=0-9=a2
gpio=12-17=a2
gpio=20-25=a2
dtoverlay=dpi24
enable_dpi_lcd=1
display_default_lcd=1
extra_transpose_buffer=2
dpi_group=2
dpi_mode=87
dpi_output_format=0x7F216
hdmi_timings=480 0 26 16 10 640 0 25 10 15 0 0 0 60 0 32000000 1
dtoverlay=waveshare-28dpi-3b-4b
dtoverlay=waveshare-28dpi-3b
dtoverlay=waveshare-28dpi-4b
dtoverlay=waveshare-touch-28dpi

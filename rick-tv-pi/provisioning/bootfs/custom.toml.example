config_version = 1

[system]
hostname = "pi"

[user]
name = "pi"
password = "YOUR_PI_PASSWORD"
password_encrypted = false

[ssh]
enabled = true
password_authentication = true

[wlan]
ssid = "Panch_2.4"
password = "YOUR_WIFI_PASSWORD_OR_64_HEX_PSK"
password_encrypted = false
hidden = false
country = "UA"

[locale]
timezone = "Europe/Kyiv"
keymap = "us"

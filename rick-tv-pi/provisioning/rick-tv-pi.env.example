# URL of Rick TV API server (например, http://192.168.1.10:8080).
RICK_TV_SERVER_URL=http://YOUR_SERVER_HOST:8080

# API token must match RICK_TV_API_TOKEN on server.
RICK_TV_API_TOKEN=YOUR_RICK_TV_API_TOKEN

# Folder on Raspberry Pi where channel folders are created and watched.
RICK_TV_MEDIA_ROOT=/home/pi/rick-tv/media

# Optional JSON metadata file for server registry channel IDs and display names.
RICK_TV_METADATA_PATH=/home/pi/rick-tv/config/channels.json

# Poll server every N seconds for ready media.
RICK_TV_POLL_INTERVAL_SECONDS=60

# Poll server every N seconds for Telegram remote-control commands.
RICK_TV_REMOTE_POLL_INTERVAL_SECONDS=2

# Root for videolooper playlists.
RICK_TV_VIDEOLOOPER_PLAYLIST_ROOT=/home/pi/rick-tv/playlists

# FIFO path used by videolooper command receiver.
RICK_TV_VIDEOLOOPER_COMMAND_PATH=/tmp/rick-tv-videolooper.fifo

# How often to reshuffle each channel playlist.
RICK_TV_CHANNEL_SHUFFLE_SECONDS=3600

# Touch screen geometry.
RICK_TV_TOUCH_SCREEN_WIDTH=480
RICK_TV_TOUCH_SCREEN_HEIGHT=640

# Whether touch axes should be swapped.
RICK_TV_TOUCH_SWAP_AXES=false

# Axis used as horizontal gesture axis: x или y.
RICK_TV_TOUCH_GESTURE_HORIZONTAL_AXIS=x

# Touch axis inversion flags (supports 1/0, true/false, on/off, yes/no).
RICK_TV_TOUCH_INVERT_X=0
RICK_TV_TOUCH_INVERT_Y=0

# Optional explicit input device path for touch.
RICK_TV_TOUCH_DEVICE=

# Main loop sleep interval in seconds.
RICK_TV_RUNTIME_TICK_SECONDS=0.1

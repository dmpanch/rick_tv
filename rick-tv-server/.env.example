# Server auth token. This value must be set and should be strong.
RICK_TV_API_TOKEN=replace_with_long_random_token

# Public URL of the server used in API download links.
RICK_TV_PUBLIC_BASE_URL=http://<SERVER_HOST>:8080

# Host directory mounted by Docker Compose for all runtime data.
# For production, prefer an absolute path such as /srv/rick-tv.
RICK_TV_DATA_DIR=./data

# Root directory for server media library files.
RICK_TV_MEDIA_DIR=/var/lib/rick-tv/media

# Directory for static server config (currently reserved by app defaults).
RICK_TV_CONFIG_DIR=/etc/rick-tv

# Directory for persisted server state.
RICK_TV_STATE_DIR=/var/lib/rick-tv/state

# Canonical SQLite database for channels, media library, and bot preferences.
# Defaults to ${RICK_TV_STATE_DIR}/rick-tv.sqlite3 when omitted.
RICK_TV_DB_PATH=/var/lib/rick-tv/state/rick-tv.sqlite3

# Legacy YAML channel registry import path. If SQLite is empty, startup imports
# this file once, then deletes it after successful migration. Runtime channel
# changes are stored in SQLite and /api/v1/channels returns JSON from DB.
RICK_TV_CHANNELS_PATH=/etc/rick-tv/channels.yml

# Host user/group used by Docker Compose so bind-mounted runtime files remain
# editable from the host. On Linux, `id -u` and `id -g` show these values.
RICK_TV_UID=1000
RICK_TV_GID=1000

# Telegram bot runner settings. Required only when starting the rick-tv-bot
# Compose service/profile.
RICK_TV_TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
RICK_TV_TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
